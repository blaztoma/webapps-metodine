# Docker only: copy this file to .env and put your key after the = sign.
#   copy .env.example .env        (macOS / Linux: cp .env.example .env)
#   notepad .env
# One line, no quotes, no spaces: ANTHROPIC_API_KEY=sk-ant-...
# .env is never committed (.gitignore) and never copied into the image (.dockerignore).
# Without a key the app works; only the model calls report that the key is missing.
ANTHROPIC_API_KEY=
